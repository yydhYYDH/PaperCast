# PaperCast 后端配置（全部有默认值，不配也能跑）
# 复制为 .env 后 chmod 600

PAPERCAST_HOST=127.0.0.1
PAPERCAST_PORT=8000
PAPERCAST_DATA_DIR=./data/runs
PAPERCAST_UPLOAD_DIR=./data/uploads
PAPERCAST_ALLOW_ORIGINS=http://127.0.0.1:5178,http://localhost:5178

# 解析引擎：pymupdf | mineru（本机无 GPU，用 pymupdf）
PAPERCAST_INTAKE_ENGINE=pymupdf
# 卡片图渲染：on | off
PAPERCAST_CARDS=on
# 留空则自动探测 Playwright 缓存里的 chrome-headless-shell
# PAPERCAST_CHROME=/home/yydh/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell
# 留空则用系统默认 CJK 字体
# PAPERCAST_CJK_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

MAX_UPLOAD_MB=200

# LLM：OpenAI 兼容端点。留空 LLM_API_KEY 时会自动读 ~/.dsh/.credentials.yaml 的 GO_API_KEY
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_TIMEOUT_SEC=600
LLM_MAX_TOKENS=16000

# 对所有 LLM 调用生效的硬上限；0 = 不限制（公众号长文写死 24000，想全局压下来就填 16000）
LLM_MAX_TOKENS_CAP=0

# 投递渠道：逗号分隔的规范 id（xiaohongshu,zhihu,bilibili）
# x = X（推特）：只出素材包的渠道（英文 thread → publish/x/export/），不接投递、不会真发
PAPERCAST_CHANNELS=xiaohongshu,zhihu,bilibili,x
# 小红书 MCP（M3 发布）
XHS_MCP_BASE=http://127.0.0.1:18060
ZHIHU_PUBLISHER_BASE=http://127.0.0.1:18070
BILIBILI_PUBLISHER_BASE=http://127.0.0.1:18080
# 素材路径映射（可选）：`本机前缀=通道服务那侧的前缀`，逗号分隔多条，长的优先。
# **MCP 跑在 Windows 侧时必需**：Windows 看不到 WSL 的文件系统，不映射的话 MCP 只会回
# 「视频文件不存在或不可访问: CreateFile …」，而且是在起浏览器之前就失败（2026-09-19 实测）。
# ops/start_all.sh 在 XHS_MCP_PLATFORM=windows 时会自动推导出一个，这里填了就以这里为准。
# 同机部署（Linux 服务器上通道服务与后端同机）留空即可 —— 路径原样传递，零影响。
# 例：CHANNEL_PATH_MAP=/home/me/proj=//wsl.localhost/Ubuntu/home/me/proj
CHANNEL_PATH_MAP=
# 真实投递前的二次校验账号（可选，防串号）：留空 = 不校验
PUBLISH_CONFIRM_ACCOUNT=

# 渲染：留空则自动探测
PAPERCAST_CHROME=
PAPERCAST_CJK_FONT=
