# PaperCast 后端配置（全部有默认值，不配也能跑）
# 复制为 .env 后 chmod 600

PAPERCAST_HOST=127.0.0.1
PAPERCAST_PORT=8000
PAPERCAST_DATA_DIR=./data/runs
PAPERCAST_UPLOAD_DIR=./data/uploads
PAPERCAST_ALLOW_ORIGINS=http://127.0.0.1:5178,http://localhost:5178

# 解析引擎：pymupdf | mineru（本机无 GPU，用 pymupdf）
PAPERCAST_INTAKE_ENGINE=pymupdf
# 卡片图渲染：on | off
PAPERCAST_CARDS=on
# 留空则自动探测 Playwright 缓存里的 chrome-headless-shell
# PAPERCAST_CHROME=/home/yydh/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell
# 留空则用系统默认 CJK 字体
# PAPERCAST_CJK_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

MAX_UPLOAD_MB=200

# LLM：OpenAI 兼容端点。留空 LLM_API_KEY 时会自动读 ~/.dsh/.credentials.yaml 的 GO_API_KEY
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_TIMEOUT_SEC=600
LLM_MAX_TOKENS=16000

# 小红书 MCP（M3 发布）
XHS_MCP_BASE=http://127.0.0.1:18060
