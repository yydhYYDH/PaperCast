+// accessBudgetMiddleware 浏览器访问预算用尽时直接拒绝。
+//
+// /api/v1 下的接口底层都可能拉起浏览器访问小红书，调用方一旦写成秒级轮询，
+// 账号在平台侧就会被判定为机器人。这里宁可拒绝也不放行：多一次真实访问就多一分风险。
+// 预算只统计「真的开了浏览器」的调用，命中 login/status 缓存的轮询不计入。
+func accessBudgetMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if used, max, window := xhsBudget.Snapshot(); max > 0 && used >= max {
+			logrus.Warnf("浏览器访问预算已用尽（近 %s 内 %d/%d），拒绝 %s %s",
