+// FindMyNote 去「我的笔记」里按标题找一条笔记，返回它的 id 与公开地址。
+// 发布成功之后调用它，把刚发出去的那条地址带回给调用方（小红书的成功页 URL 里没有笔记号）。
+// 找不到就返回空串：列表有刷新延迟，宁可没有地址，也不能给一个错地址。
+func (u *UserProfileAction) FindMyNote(ctx context.Context, title string) (id, url string) {
+	title = strings.TrimSpace(title)
+	if title == "" {
+		return "", ""
+	}
+
+	resp, err := u.GetMyProfileViaSidebar(ctx, TabNotes)
+	if err != nil {
+		slog.Warn("发布后读不到我的笔记列表，这次回执里就没有笔记地址", "err", err)
+		return "", ""
+	}
+	for _, f := range resp.Feeds {
+		if strings.TrimSpace(f.NoteCard.DisplayTitle) == title {
+			return f.ID, makeFeedDetailURL(f.ID, f.XsecToken)
+		}
+	}
+	slog.Warn("我的笔记列表里没有标题匹配的那条（可能还没刷新出来）", "title", title)
+	return "", ""
+}
