diff --git a/xiaohongshu/comment_feed_test.go b/xiaohongshu/comment_feed_test.go
new file mode 100644
index 0000000..ec4711c
--- /dev/null
+++ b/xiaohongshu/comment_feed_test.go
@@ -0,0 +1,19 @@
+package xiaohongshu
+
+import "testing"
+
+// 评论校验前的归一化：去掉全部空白，避免平台重排换行导致「已发出却判失败」。
+func TestNormalizeCommentText(t *testing.T) {
+	cases := []struct{ in, want string }{
+		{"a\nb", "ab"},
+		{"论文 arXiv 2610.02162\nhttps://arxiv.org/abs/2610.02162", "论文arXiv2610.02162https://arxiv.org/abs/2610.02162"},
+		{"  多  空  格  ", "多空格"},
+		{"", ""},
+		{"\n\t ", ""},
+	}
+	for _, c := range cases {
+		if got := normalizeCommentText(c.in); got != c.want {
+			t.Errorf("normalizeCommentText(%q) = %q, want %q", c.in, got, c.want)
+		}
+	}
+}
