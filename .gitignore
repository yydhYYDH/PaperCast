# 工作区根仓库的忽略规则（规范见 docs/conventions.md）
# 原则：代码进版本库，运行态 / 依赖 / 密钥 / 上游克隆不进。

# —— 运行态：全部在 var/，可删可重建 ——
/var/

# —— 依赖与构建产物 ——
# ops/bin 是本地编译出来的二进制（小红书 MCP 等），**不入库**：
# 别人 clone 后自己编，见 docs/INSTALL.md §5.2 与 ./ops/build_mcp.sh
/ops/bin/

# 演示媒体同样是大文件（19 MB），入库会让 .git 爆到 90 MB+：
# 真产物在 var/ 里（本就不入库），示例片源按需从上游重新获取
apps/papercast/public/samples/video/*.mp4
node_modules/
dist/
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# —— 密钥、账号、本地配置（绝不入库）——
cookies.json
.env
.env.*
!.env.example

# —— 上游参考：各自带 .git，克隆方式与版本记录在 docs/research/upstream-repos.md ——
/reference/upstream/
/reference/baoyu-research/

# —— 独立仓库的组件（有自己的 git 历史，不作为子树提交）——
/apps/xiaohongshu-mcp/

# —— 通用工具目录：万一有工具往根目录写，别让它入库 ——
/.cache/
/.tools/

# —— 工具误写到根目录的临时文件（根目录只允许 3 个文件，这些别入库）——
*.ses
:memory:*

# —— 编辑器 / 系统 ——
.DS_Store
*.swp
.idea/
.vscode/
